    "expenses",
    "tracking"
  ],
  "author": "Desenvolvedor",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
