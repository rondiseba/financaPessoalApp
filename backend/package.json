{
  "name": "controle-gastos-backend",
  "version": "1.0.0",
  "description": "Backend para aplicação de controle de gastos pessoais",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "test": "jest",
